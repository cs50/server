#!/bin/bash

# PHP version shipped by the base image's Ubuntu release (must match Dockerfile and nginx.conf.erb)
PHP_VERSION=8.5

# Inject environment variables into pool
sed -i '/^env\[.\+\] *=.*/d' /etc/php/$PHP_VERSION/fpm/pool.d/www.conf
env | grep -v ^PASSENGER_ | grep -v =$ | sed 's/\([^=]\+\)=\(.*\)/env[\1]=\"\2\"/' | awk 'length <= 1024' >> /etc/php/$PHP_VERSION/fpm/pool.d/www.conf

# Harden pool (php_admin_* can't be overridden by ini_set or .user.ini)
# Disable session upload progress, a confirmed trigger for CVE-2026-109619 (php2shell),
# https://github.com/php/php-src/security/advisories/GHSA-6wmf-4rv5-p3rp
sed -i '/^php_admin_flag\[session\.upload_progress\.enabled\] *=.*/d' /etc/php/$PHP_VERSION/fpm/pool.d/www.conf
echo 'php_admin_flag[session.upload_progress.enabled] = off' >> /etc/php/$PHP_VERSION/fpm/pool.d/www.conf

# Enable Xdebug (and other PHP-recommended directives) in development mode
if [ "$APPLICATION_ENV" == "dev" ]; then
    phpenmod xdebug && cp -f /usr/lib/php/$PHP_VERSION/php.ini-development /etc/php/$PHP_VERSION/fpm/php.ini
else
    phpdismod xdebug && cp -f /usr/lib/php/$PHP_VERSION/php.ini-production /etc/php/$PHP_VERSION/fpm/php.ini
fi

# Match Nginx's client_max_body_size
sed -i 's/post_max_size\s*=.*/post_max_size = 1024M/' /etc/php/$PHP_VERSION/fpm/php.ini
sed -i 's/upload_max_filesize\s*=.*/upload_max_filesize = 1024M/' /etc/php/$PHP_VERSION/fpm/php.ini

# Start PHP-FPM
/etc/init.d/php$PHP_VERSION-fpm start

# Default to production mode
PASSENGER_ENVIRONMENT="production"

# Restart application after every request in development mode
if [ "$APPLICATION_ENV" == "dev" ]; then
    mkdir -p tmp && touch tmp/always_restart.txt
    PASSENGER_ENVIRONMENT="development"
fi

# Set file-creation mask
umask 0077

# Check for --nginx-bin
if [[ "$1" == "start" ]] ; then
    NGINX_BIN="--nginx-bin=/opt/nginx/sbin/nginx"
    for i in "${@:2}" ; do
        if [[ "$i" == --nginx-bin ]] || [[ "$i" == --nginx-bin=* ]] ; then
            NGINX_BIN=
            break
        fi
    done
fi

# Configure Passenger, as per https://www.phusionpassenger.com/library/config/standalone/reference/
PASSENGER_ENVIRONMENT="$PASSENGER_ENVIRONMENT" \
PASSENGER_GROUP=www-data \
PASSENGER_LOG_FILE=/var/log/passenger.log \
PASSENGER_NGINX_CONFIG_TEMPLATE=/opt/cs50/etc/nginx.conf.erb \
PASSENGER_PID_FILE=/var/run/passenger.pid \
PASSENGER_PORT=8080 \
PASSENGER_PYTHON=python3 \
PASSENGER_TURBOCACHING=false \
PASSENGER_USER=www-data \
/usr/bin/passenger "$@" "$NGINX_BIN"

# Remove tmp/always_restart.txt in development mode
if [ "$APPLICATION_ENV" == "dev" ]; then
    rm -f tmp/always_restart.txt
fi

# Stop PHP-FPM
/etc/init.d/php$PHP_VERSION-fpm stop
